#include <stdio.h>
#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* nextGreaterElement(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
    // Allocate memory for the answer array
    int* ans = (int*)malloc(nums1Size * sizeof(int));
    *returnSize = nums1Size;

    // Create a stack to keep track of elements whose next greater element is not yet found
    int* stack = (int*)malloc(nums2Size * sizeof(int));
    int top = -1;

    // A simple fixed-size map or direct indexing array if elements are within a standard range.
    // For general numbers, we look at the max element or use a large enough array for LeetCode constraints.
    // Constraints on LeetCode for this problem state: 0 <= nums1[i], nums2[i] <= 10000
    int map[10001];
    for (int i = 0; i <= 10000; i++) {
        map[i] = -1; // Initialize map values to -1
    }

    // Traverse nums2 to find the next greater element for each number
    for (int i = 0; i < nums2Size; i++) {
        // While stack is not empty and current element is greater than the stack top element
        while (top >= 0 && nums2[i] > stack[top]) {
            map[stack[top]] = nums2[i]; // Store the next greater element in map
            top--; // Pop from stack
        }
        // Push the current element onto the stack
        stack[++top] = nums2[i];
    }

    // For any remaining elements in the stack, their next greater element is already -1 (default)

    // Build the answer array using the map results for elements in nums1
    for (int i = 0; i < nums1Size; i++) {
        ans[i] = map[nums1[i]];
    }

    // Free temporary memory allocated for stack
    free(stack);

    return ans;
}
